<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tùy chỉnh chế độ đọc"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface"
        android:layout_marginBottom="16dp" />

    <!-- Font Size Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cỡ chữ"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgReaderFontSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rbReaderFontSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhỏ" />

        <RadioButton
            android:id="@+id/rbReaderFontMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Vừa" />

        <RadioButton
            android:id="@+id/rbReaderFontLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Lớn" />

        <RadioButton
            android:id="@+id/rbReaderFontXLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Rất lớn" />
    </RadioGroup>

    <!-- Theme Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Màu nền"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgReaderTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbThemeLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sáng" />

        <RadioButton
            android:id="@+id/rbThemeDark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Tối" />

        <RadioButton
            android:id="@+id/rbThemeSepia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Nâu giấy (Sepia)" />
    </RadioGroup>

</LinearLayout>
